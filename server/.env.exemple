# If using Docker container
MONGO_ADMIN_USERNAME=
MONGO_ADMIN_PASSWORD=

# If using remote MongoDB instance
MONGODB_URI=mongodb://user:password@host:port/database

# Azure Translator instance
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://<instance>.cognitiveservices.azure.com

# Azure Speech instance
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=https://<instance>.cognitiveservices.azure.com

# Gemini API info
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite (or whichever model preferred / available)

# JWT secret key
JWT_KEY=
JWT_REFRESH_KEY=
